# Prevent execution of any server-side scripts uploaded to this directory.
# This is a defence-in-depth measure against polyglot file attacks where a
# valid image file also contains embedded PHP/script code.

Options -ExecCGI -Indexes
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .shtml .pl .cgi
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|shtml|pl|cgi|py|rb|sh)$">
    Require all denied
</FilesMatch>

# Force all files to be served as static content
AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
