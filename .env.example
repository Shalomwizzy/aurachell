APP_NAME=Aurachell
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aurachell
DB_USERNAME=root
DB_PASSWORD=
MYSQL_DUMP_PATH=/usr/bin          # Hostinger: /usr/bin  |  local DBngin: /Users/Shared/DBngin/mysql/8.0.33/bin
BACKUP_ARCHIVE_PASSWORD=          # Optional: encrypt backup zips

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Paystack Payment Gateway
# Get keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PAYMENT_URL=https://api.paystack.co
MERCHANT_EMAIL=admin@yourdomain.com

# Flutterwave Payment Gateway
# Get keys from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_hash

# Groq AI (Customer Chatbot)
# Get API key from https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Gemini AI (Admin AI Studio + Product Description Generation)
# Get API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Seeder Credentials (used by AdminUserSeeder)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@2026!
ADMIN_PHONE=

# Google Analytics 4
# Get Measurement ID from https://analytics.google.com
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Facebook Pixel
# Get Pixel ID from Meta Business Suite → Events Manager → Your Pixel → Settings
FACEBOOK_PIXEL_ID=

# OneSignal Web Push Notifications
# Get App ID from onesignal.com → Your App → Settings → Keys & IDs
ONESIGNAL_APP_ID=

# Google Analytics Data API (for admin analytics dashboard)
# Get Property ID from GA4 → Admin → Property Details
ANALYTICS_PROPERTY_ID=

# Mail (Mailtrap for dev, SMTP for production)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (optional, not used by default — images go to public/images/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
